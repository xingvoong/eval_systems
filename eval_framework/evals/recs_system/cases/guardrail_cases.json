    "notes": "Valid JSON output is safe"
  },
  {
    "id": "g_007",
    "category": "output",
    "output": "{\"error\": \"unknown check 'bad'\"}",
    "expected_safe": false,
    "notes": "Error in output should be flagged"
  },
  {
    "id": "g_008",
    "category": "output",
    "output": "Traceback (most recent call last): KeyError: 'candidates'",
