  {
    "id": "g_002",
    "category": "input",
    "input": "unknown_check|{}",
    "expected_valid": false,
    "notes": "Unknown check name should be rejected"
  },
  {
    "id": "g_003",
    "category": "input",
    "input": "filter_seen|not-valid-json",
    "expected_valid": false,
    "notes": "Invalid JSON payload should be rejected"
  },
  {
    "id": "g_004",
    "category": "input",
    "input": "filter_seen|",
    "expected_valid": false,
    "notes": "Missing payload should be rejected"
  },
  {
    "id": "g_005",
    "category": "input",
    "input": "filter_seen|{\"candidates\": [[1, 0.9]], \"seen\": []}",
    "expected_valid": true,
    "notes": "Valid filter_seen input should pass"
  },
  {
    "id": "g_006",
    "category": "output",
    "output": "{\"remaining\": [[1, 0.9], [3, 0.7]]}",
